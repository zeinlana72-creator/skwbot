# Konfigurasi Bot Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Konfigurasi Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json
SHEET_NAME=KAWAL MPW
WEB_APP_URL=https://script.google.com/macros/s/your_app_url/exec

# Khusus Deploy Cloud (seperti Railway):
# Salin dan tempel seluruh isi teks credentials.json ke variabel ini jika file tidak diunggah ke GitHub:
GOOGLE_CREDENTIALS_JSON=

# Konfigurasi Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Konfigurasi Tambahan (Opsional)
# Pisahkan ID User Telegram dengan koma jika ingin membatasi akses bot
ALLOWED_TELEGRAM_IDS=
